# Embeds a text file into a target as a function returning its bytes.
#
#   air_embed_text(TARGET air_renderer SOURCE report/Page.html NAME PageHtml)
#
# compiles `std::string_view air::embedded::PageHtml()` into the target. The bytes are written to a
# generated .cpp at build time, so editing the file rebuilds the target. Declare the function where
# it is used: `namespace air::embedded { std::string_view PageHtml(); }`.

# Script mode: cmake -DINPUT=<file> -DOUTPUT=<cpp> -DNAME=<function> -P AirEmbed.cmake
if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${INPUT}" hex HEX)
    # 16 bytes (32 hex digits) per line, each byte as 0x.., (CMake regexes have no {n} repeats).
    string(REGEX REPLACE "(................................)" "\\1\n" hex "${hex}")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(WRITE "${OUTPUT}"
         "// Generated by cmake/AirEmbed.cmake from ${INPUT}. Do not edit.\n"
         "#include <string_view>\n\n"
         "namespace air::embedded\n{\n\n"
         "namespace\n{\nconst unsigned char kData[] = {\n${bytes}0x00};\n}\n\n"
         "std::string_view ${NAME}()\n{\n"
         "    return {reinterpret_cast<const char*>(kData), sizeof(kData) - 1};\n}\n\n"
         "} // namespace air::embedded\n")
    return()
endif()

function(air_embed_text)
    cmake_parse_arguments(ARG "" "TARGET;SOURCE;NAME" "" ${ARGN})
    set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded/${ARG_NAME}.cpp")
    add_custom_command(
        OUTPUT "${output}"
        COMMAND ${CMAKE_COMMAND} -DINPUT=${ARG_SOURCE} -DOUTPUT=${output} -DNAME=${ARG_NAME} -P
                ${CMAKE_CURRENT_FUNCTION_LIST_FILE}
        DEPENDS "${ARG_SOURCE}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        COMMENT "Embedding ${ARG_SOURCE}"
        VERBATIM)
    target_sources(${ARG_TARGET} PRIVATE "${output}")
endfunction()
